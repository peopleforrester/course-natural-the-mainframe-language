DEFINE DATA LOCAL
1 EMPLOYEES-VIEW VIEW OF EMPLOYEES
2 NAME
2 COUNTRY
2 SALARY
1 #TOTAL (P11)
1 #COUNT (I4)
1 #AVERAGE (N9.2)
END-DEFINE
WRITE 'PAYROLL ANALYSIS'
PERFORM GATHER-TOTALS
PERFORM SHOW-AVERAGE
DEFINE SUBROUTINE GATHER-TOTALS
READ EMPLOYEES-VIEW
ADD SALARY TO #TOTAL
ADD 1 TO #COUNT
END-READ
END-SUBROUTINE
DEFINE SUBROUTINE SHOW-AVERAGE
COMPUTE ROUNDED #AVERAGE = #TOTAL / #COUNT
WRITE 'Employees:' #COUNT
WRITE 'Payroll:  ' #TOTAL
WRITE 'Average:  ' #AVERAGE
END-SUBROUTINE
END
