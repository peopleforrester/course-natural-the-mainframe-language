DEFINE DATA LOCAL
1 EMPLOYEES-VIEW VIEW OF EMPLOYEES
2 PERSONNEL-ID
2 NAME
2 FIRST-NAME
2 CITY
2 COUNTRY
2 DEPT
2 JOB-TITLE
2 SALARY
1 #TOTAL (P11)
1 #RAISE (N9.2)
1 #GRADE (A8)
END-DEFINE
WRITE 'STAFF REVIEW'
WRITE ' '
HISTOGRAM EMPLOYEES-VIEW FOR COUNTRY
WRITE 'Country' COUNTRY 'has' *NUMBER 'staff'
END-HISTOGRAM
WRITE ' '
READ EMPLOYEES-VIEW BY NAME
ADD SALARY TO #TOTAL
DECIDE FOR FIRST CONDITION
WHEN SALARY >= 60000
MOVE 'SENIOR' TO #GRADE
WHEN SALARY >= 40000
MOVE 'MID' TO #GRADE
WHEN NONE
MOVE 'JUNIOR' TO #GRADE
END-DECIDE
DISPLAY NAME COUNTRY SALARY #GRADE
END-READ
WRITE ' '
WRITE 'Total payroll:' #TOTAL
COMPUTE ROUNDED #RAISE = #TOTAL * 0.035
WRITE 'Budget for 3.5% raises:' #RAISE
WRITE ' '
FIND EMPLOYEES-VIEW WITH COUNTRY = 'UK' WHERE SALARY < 30000
COMPUTE SALARY = SALARY * 1.10
UPDATE
WRITE 'Raised' NAME
END-FIND
END TRANSACTION
FIND EMPLOYEES-VIEW WITH NAME = 'GARRET'
WRITE 'GARRET now earns' SALARY
END-FIND
END
