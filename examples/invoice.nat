DEFINE DATA LOCAL
1 #I (I4)
1 #PRICE (N7.2)
1 #QTY (I4)
1 #LINE (N9.2)
1 #TOTAL (N9.2)
1 #TAX (N9.2)
END-DEFINE
WRITE 'INVOICE'
MOVE 19.99 TO #PRICE
FOR #I = 1 TO 3
COMPUTE #QTY = #I * 2
COMPUTE #LINE = #PRICE * #QTY
WRITE 'qty' #QTY 'at' #PRICE '=' #LINE
ADD #LINE TO #TOTAL
END-FOR
COMPUTE ROUNDED #TAX = #TOTAL * 0.0825
WRITE 'Subtotal:' #TOTAL
WRITE 'Tax:     ' #TAX
COMPUTE #TOTAL = #TOTAL + #TAX
WRITE 'Total:   ' #TOTAL
END
