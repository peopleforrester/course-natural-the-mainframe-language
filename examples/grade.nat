DEFINE DATA LOCAL
1 #SCORE (N3)
1 #GRADE (A1)
END-DEFINE
MOVE 87 TO #SCORE
DECIDE FOR FIRST CONDITION
WHEN #SCORE >= 90
MOVE 'A' TO #GRADE
WHEN #SCORE >= 80
MOVE 'B' TO #GRADE
WHEN #SCORE >= 70
MOVE 'C' TO #GRADE
WHEN NONE
MOVE 'F' TO #GRADE
END-DECIDE
WRITE 'Score' #SCORE 'earns grade' #GRADE
DECIDE ON FIRST VALUE OF #GRADE
VALUE 'A', 'B'
WRITE 'Honour roll.'
VALUE 'C'
WRITE 'Satisfactory.'
NONE VALUE
WRITE 'Needs work.'
END-DECIDE
END
