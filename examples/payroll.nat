DEFINE DATA LOCAL
1 EMPLOYEES-VIEW VIEW OF EMPLOYEES
2 NAME
2 FIRST-NAME
2 CITY
2 COUNTRY
2 SALARY
1 #TOTAL (P11)
1 #COUNT (I4)
END-DEFINE
WRITE 'US PAYROLL REPORT'
READ EMPLOYEES-VIEW BY NAME
IF COUNTRY = 'USA'
DISPLAY NAME FIRST-NAME CITY SALARY
ADD SALARY TO #TOTAL
ADD 1 TO #COUNT
END-IF
END-READ
WRITE 'Employees:' #COUNT
WRITE 'Payroll:  ' #TOTAL
END
