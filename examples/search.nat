DEFINE DATA LOCAL
1 EMPLOYEES-VIEW VIEW OF EMPLOYEES
2 NAME
2 FIRST-NAME
2 CITY
2 COUNTRY
2 SALARY
END-DEFINE
WRITE 'SENIOR US STAFF'
SR. FIND EMPLOYEES-VIEW WITH COUNTRY = 'USA' SORTED BY NAME WHERE SALARY > 45000
DISPLAY *COUNTER NAME CITY SALARY
END-FIND
WRITE 'Matched by search:' *NUMBER(SR.)
WRITE ' '
FIND EMPLOYEES-VIEW WITH CITY = 'ATLANTIS'
IF NO RECORDS FOUND
WRITE 'No one works in ATLANTIS.'
ESCAPE BOTTOM
END-NOREC
WRITE NAME
END-FIND
END
